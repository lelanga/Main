# Copy to .env (same folder) and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Leave empty at first; message the bot and it replies with your chat ID
TELEGRAM_CHAT_ID=

# ---- Optional ----
# Folder Claude works in
CLAUDE_WORKDIR=~
# default | acceptEdits | plan | bypassPermissions (bypass = full unattended control)
CLAUDE_PERMISSION_MODE=acceptEdits
# Pre-approved tools, e.g. "Bash Read Edit Write WebFetch WebSearch"
CLAUDE_ALLOWED_TOOLS=
# e.g. opus or sonnet; empty = Claude Code default
CLAUDE_MODEL=
# Seconds before a task is killed
CLAUDE_TIMEOUT=1800
# Path to the Claude Code CLI
CLAUDE_BIN=claude
